# cp secret.yaml.example secret.yaml && edit && kubectl apply -f secret.yaml
# secret.yaml is gitignored.
apiVersion: v1
kind: Secret
metadata:
  name: ilcc-secret
  namespace: hydra-infra
  labels:
    app: ilcc
type: Opaque
stringData:
  # Must match the value in middleware.yaml (ilcc-proxy-secret). Generate: openssl rand -hex 32
  HYDRA_PROXY_SECRET: "CHANGE-ME"
  # Comma-separated. Faculty (SAML affiliation) are admins automatically.
  SEED_ADMINS: "gopeen1@newpaltz.edu"
